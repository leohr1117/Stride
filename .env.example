# Vorlage für die Umgebungsvariablen von Stride. Alle Werte sind optional.
# Als Umgebungsvariablen setzen, z. B. als .env kopieren und den Server mit
# node --env-file=.env --disable-warning=ExperimentalWarning server/index.ts starten.

# Port des Servers (Standard 3000)
PORT=3000
# Datenbank und Zugangsdatenbank (Standard data/app.db und data/zugang.db).
# STRIDE_DB_PFAD und STRIDE_ZUGANG_PFAD gelten vor den alten Namen DB_PFAD und ZUGANG_PFAD.
STRIDE_DB_PFAD=data/app.db
STRIDE_ZUGANG_PFAD=data/zugang.db
# Log-Stufe (Standard warn)
LOG_LEVEL=warn
# Ordner für ein zusätzliches Tagesprotokoll. Jeder Tag ist eine eigene Datei.
# Dateien, die älter als 14 Tage sind, werden gelöscht. Nicht die Datenbankdatei eintragen.
# Ohne diese Variable schreibt der Server nur auf die Konsole. ASCEND_LOG_PFAD wird weiter gelesen.
# STRIDE_LOG_PFAD=

# Ordner der Oberfläche für den laufenden Server.
# Standard ist client/dist-live. Der Bau bleibt in client/dist.
# Der alte Name ASCEND_CLIENT_DIR wird weiter gelesen.
# STRIDE_CLIENT_DIR=client/dist-live

# 32 Byte Base64. Ohne ihn lässt sich Todoist nicht neu einrichten, vorhandene Tokens bleiben unverschlüsselt.
# Ist er gesetzt, packt der Start sie einmal. Wer ihn ändert, gibt die Tokens neu ein.
# Der alte Name ASCEND_TOKEN_SCHLUESSEL wird weiter gelesen.
# STRIDE_TOKEN_SCHLUESSEL=

# Admin: Das Konto muss schon existieren. Den Namen hier eintragen und den Server neu starten.
# Danach zählt die gespeicherte Konto-ID. Ein späteres Konto mit demselben Namen ist kein Admin.
# Die Selbst-Registrierung dieses Namens bleibt gesperrt. ASCEND_ADMIN wird weiter gelesen.
# Fehlt das Konto beim ersten Start, wird nichts gespeichert; der nächste Start versucht es erneut.
# Nach dem Löschen bindet beim nächsten Start nur ein anderer Name, und nur wenn das Konto schon existiert.
# Sonst warnt das Log. Eine spätere Registrierung bindet nicht. Derselbe Name bindet nie wieder.
STRIDE_ADMIN=

# 1 erlaubt neuen Nutzern, selbst ein Konto zu erstellen. Standard aus.
# STRIDE_REGISTRIERUNG=1

# 1 erlaubt die Anmeldung über Google. Standard aus. Wirkt nur mit Client-ID und Secret.
# In der Google Cloud Console die Weiterleitungs-URI https://<host>/api/zugang/google/zurueck eintragen.
# STRIDE_GOOGLE=1
# STRIDE_GOOGLE_CLIENT_ID=
# STRIDE_GOOGLE_CLIENT_SECRET=

# Schlüssel für Web-Push. VAPID_SUBJECT ist eine mailto:- oder https:-Adresse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Adresse der Todoist-API (Standard https://api.todoist.com/api/v1/)
# TODOIST_API=https://api.todoist.com/api/v1/

# Nur für Tests: 1 schaltet den Testmodus ein. Der alte Name ASCEND_TEST wird weiter gelesen.
# POST /api/test/heute mit { datum } setzt die Spieluhr (Kette, Einträge, Verfall, Bosse, Buchungen, Kalender- und Todoist-Zuordnung).
# Sitzungen und Sperren bleiben echte Zeit. Der Server warnt beim Start. datum: null stellt die echte Uhr wieder her.
# STRIDE_TEST=1
